{
  "openapi": "3.0.3",
  "info": {
    "title": "shopmesh gateway",
    "version": "1.0.0",
    "description": "Public edge service. Serves products and proxies order operations to the orders service."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": { "status": "ok", "service": "gateway" }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List products",
        "responses": {
          "200": {
            "description": "All products",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
                "example": [
                  { "id": "7b2c...", "name": "Classic Tee", "sku": "TEE-001", "priceCents": 1999, "createdAt": "2024-01-01T00:00:00.000Z" }
                ]
              }
            }
          }
        }
      }
    },
    "/checkout": {
      "post": {
        "summary": "Create an order (proxies to orders service)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckoutRequest" },
              "example": {
                "customerEmail": "a@b.com",
                "items": [{ "sku": "TEE-001", "name": "Classic Tee", "quantity": 2, "priceCents": 1999 }]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "502": {
            "description": "Upstream (orders) failure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Fetch an order by id (proxies to orders service)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "3f9a1c2e-..." }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "502": {
            "description": "Upstream (orders) failure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": { "status": { "type": "string" }, "service": { "type": "string" } }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sku": { "type": "string" },
          "priceCents": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CheckoutItem": {
        "type": "object",
        "required": ["sku", "name", "quantity", "priceCents"],
        "properties": {
          "sku": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "integer" },
          "priceCents": { "type": "integer" }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": ["customerEmail", "items"],
        "properties": {
          "customerEmail": { "type": "string", "format": "email" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CheckoutItem" } }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "customerEmail": { "type": "string" },
          "totalCents": { "type": "integer" },
          "chargeId": { "type": "string", "nullable": true },
          "shipmentId": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CheckoutItem" } }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
