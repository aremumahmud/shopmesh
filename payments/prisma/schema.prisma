generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Charge {
  id          String   @id @default(uuid())
  amountCents Int
  stripeRef   String?
  status      String   @default("succeeded")
  createdAt   DateTime @default(now())
}
